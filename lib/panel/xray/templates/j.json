# lib/panel/xray/templates/j.json — jq FILTER (not static JSON — read via
# `jq -f`, see lib/panel/xray/templates/render.sh) producing the Xray "inbounds"
# array for Variant J's dual-inbound shape: Steal (Vision/REALITY, identical
# in shape to f.json's single inbound) + StealXHTTP (REALITY over XHTTP,
# Variant J's second public leg — nginx :$J_XHTTP_PUBLIC_PORT in
# lib/panel/nginx/variant_j.sh proxy_passes to this inbound's loopback port).
#
# HISTORICAL NOTE (2026-08-31): this file was originally referenced by
# name in f.json's header comment, in render.sh's MODE=J dispatch branch,
# and in lib/panel/api.sh's comments before it actually existed —
# `git log --all -- lib/panel/xray/templates/j.json` returned nothing at
# that point. Every MODE=J install would have called
# panel_xray_render_inbounds(), which resolves
# TEMPLATE="${_PANEL_XRAY_TEMPLATE_DIR}/j.json" for MODE=J and passes it to
# `jq -n ... -f "$TEMPLATE" 2>/dev/null` — a nonexistent file makes jq exit
# non-zero with its error suppressed by that redirect, so
# panel_xray_render_inbounds would silently print nothing, and
# panel_setup_api()'s own `[ -z "$INBOUNDS_JSON" ] && err ...` guard would
# abort every MODE=J run right after key generation. Confirmed by actually
# invoking the renderer before adding this file (see regression report at
# the time, commit 93d9d2f) — not inferred from reading the code alone.
# This file has existed and been committed since 93d9d2f; the gap
# described above is resolved and kept only as a record of the bug.
#
# Both inbounds share privateKey/serverNames/shortIds — same REALITY
# identity — because that's what makes both reachable under the same
# domain on two different public ports (Vision on :443 via nginx's
# xray_vision upstream, XHTTP on :$J_XHTTP_PUBLIC_PORT via nginx's
# xray_xhttp upstream — see variant_j.sh). Only tag/port/network/
# xhttpSettings differ between them.
#
# Bound variables (via jq --arg/--argjson in render.sh — same full set
# render.sh binds for f.json; this template is simply the one that uses
# all of them instead of leaving $xport/$xpath unused):
#   $vport      — Steal (Vision) REALITY inbound port (panel_reality_inbound_port)
#   $xport      — StealXHTTP inbound port (panel_reality_xhttp_inbound_port)
#   $xpath      — StealXHTTP's xhttpSettings.path (random per install, see
#                 panel_setup_api()'s $XHTTP_PATH)
#   $pk         — REALITY private key (shared by both inbounds)
#   $sid        — REALITY short ID (shared by both inbounds)
#   $dest       — REALITY fallback dest (panel_reality_dest_val)
#   $domain     — REALITY serverName (SELFSTEAL_DOMAIN, shared by both inbounds)
#   $accept_pp  — sockopt.acceptProxyProtocol toggle (panel_reality_accept_proxy_protocol).
#                 Applied ONLY to Steal, never to StealXHTTP — see
#                 lib/panel/nginx/variant_j.sh's :$J_XHTTP_PUBLIC_PORT
#                 server{} (no `proxy_protocol on;` there, deliberately) and
#                 lib/panel/api.sh's panel_reality_accept_proxy_protocol()
#                 doc comment (2026-08-31 fix: StealXHTTP does not receive
#                 a PROXY preamble, so it must not expect one either — a
#                 mismatch here would break every MODE=J REALITY handshake
#                 on the XHTTP leg, not just fail to help).
#   $listen     — optional inbound "listen" bind address (panel_reality_listen_addr).
#                 J always passes "127.0.0.1" (both inbounds sit behind
#                 nginx's stream{} router — see variant_j.sh's header
#                 comment — and were always meant to be loopback-only;
#                 this field is what actually enforces that, previously
#                 unenforced). Applied to BOTH Steal and StealXHTTP —
#                 unlike $accept_pp, which is Steal-only, the loopback-bind
#                 requirement applies equally to both inbounds, since both
#                 are reached exclusively via nginx's own loopback
#                 proxy_pass/upstream (xray_vision and xray_xhttp).
[
    (
        {
            "tag": "Steal",
            "port": $vport,
            "protocol": "vless",
            "settings": { "clients": [], "decryption": "none" },
            "sniffing": { "enabled": true, "destOverride": ["http", "tls", "quic"] },
            "streamSettings": (
                {
                    "network": "tcp",
                    "security": "reality",
                    "realitySettings": {
                        "show": false,
                        "xver": 1,
                        "dest": $dest,
                        "spiderX": "",
                        "shortIds": [$sid],
                        "privateKey": $pk,
                        "serverNames": [$domain]
                    }
                }
                + (if $accept_pp then { "sockopt": { "acceptProxyProtocol": true } } else {} end)
            )
        }
        + (if ($listen // "") != "" then { "listen": $listen } else {} end)
    ),
    (
        {
            "tag": "StealXHTTP",
            "port": $xport,
            "protocol": "vless",
            "settings": { "clients": [], "decryption": "none" },
            "sniffing": { "enabled": true, "destOverride": ["http", "tls", "quic"] },
            "streamSettings": {
                "network": "xhttp",
                "security": "reality",
                "realitySettings": {
                    "show": false,
                    "xver": 1,
                    "dest": $dest,
                    "spiderX": "",
                    "shortIds": [$sid],
                    "privateKey": $pk,
                    "serverNames": [$domain]
                },
                "xhttpSettings": { "path": $xpath }
            }
        }
        + (if ($listen // "") != "" then { "listen": $listen } else {} end)
    )
]
