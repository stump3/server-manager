diff --git a/lib/panel/node/api.sh b/lib/panel/node/api.sh
new file mode 100644
index 0000000..b71a757
--- /dev/null
+++ b/lib/panel/node/api.sh
@@ -0,0 +1,102 @@
+# shellcheck shell=bash
+#
+# lib/panel/node/api.sh — Panel API: регистрация Remote Node + health-check.
+#
+# Использует panel_api_request()/panel_get_token() (lib/panel/core.sh) —
+# ту же конвенцию, что уже применяет lib/panel/warp.sh для действий над
+# уже установленной панелью (относительные пути + $PANEL_API, кэшируемый
+# токен через $PANEL_TOKEN_FILE). Это НЕ panel_api() из
+# lib/common/network.sh — тот вариант (полный URL, без кэша токена)
+# используется только внутри panel_setup_api() в рамках первичной
+# установки и намеренно не трогается (byte-identical MODE=1 требование).
+#
+# НЕ ПРОТЕСТИРОВАНО на реальном Panel API. Формат запросов построен по
+# образцу уже работающего panel_setup_api() (тот же JSON-контракт
+# /api/config-profiles и /api/nodes), но GET-эндпоинт для health-check
+# (список /api/nodes + фильтрация по uuid) — предположение по REST-
+# конвенции и по уже используемому в проекте паттерну
+# (GET /api/internal-squads + jq-фильтрация, см. panel_setup_api()),
+# не подтверждено вызовом к живому API.
+
+# panel_node_register <token> <selfsteal_domain> <node_addr>
+# Создаёт Reality config-profile (DEST=/dev/shm/nginx.sock, всегда —
+# см. Stage 7 инвариант: Remote Node fallback никогда не идёт на
+# ${domain}:443) + inbound, затем регистрирует ноду через POST /api/nodes.
+# Печатает ТОЛЬКО nodeUuid в stdout при успехе (вызывающий код использует
+# $(panel_node_register ...) для получения значения) — все статусные
+# сообщения (ok/warn) намеренно направлены в stderr (>&2), иначе они
+# попали бы в захватываемый stdout и испортили бы значение node_uuid.
+# Возвращает 1 при неудаче.
+panel_node_register() {
+    local token="$1" selfsteal_domain="$2" node_addr="$3"
+
+    local keys_r priv_key
+    keys_r=$(panel_api_request "GET" "/api/system/tools/x25519/generate" "$token")
+    priv_key=$(echo "$keys_r" | jq -r '.response.keypairs[0].privateKey // empty' 2>/dev/null)
+    if [ -z "$priv_key" ]; then
+        warn "Ошибка генерации Reality-ключей" >&2
+        return 1
+    fi
+
+    local short_id
+    short_id=$(openssl rand -hex 8)
+
+    local profile_r
+    profile_r=$(panel_api_request "POST" "/api/config-profiles" "$token" "$(jq -n \
+        --arg name "Steal-${selfsteal_domain}" --arg domain "$selfsteal_domain" \
+        --arg pk "$priv_key" --arg sid "$short_id" --arg dest "/dev/shm/nginx.sock" \
+        '{name:$name,config:{log:{loglevel:"warning"},dns:{queryStrategy:"UseIPv4",servers:[{address:"https://dns.google/dns-query",skipFallback:false}]},inbounds:[{tag:"Steal",port:443,protocol:"vless",settings:{clients:[],decryption:"none"},sniffing:{enabled:true,destOverride:["http","tls","quic"]},streamSettings:{network:"tcp",security:"reality",realitySettings:{show:false,xver:1,dest:$dest,spiderX:"",shortIds:[$sid],privateKey:$pk,serverNames:[$domain]}}}],outbounds:[{tag:"DIRECT",protocol:"freedom"},{tag:"BLOCK",protocol:"blackhole"}],routing:{rules:[{ip:["geoip:private"],type:"field",outboundTag:"BLOCK"},{type:"field",protocol:["bittorrent"],outboundTag:"BLOCK"}]}}}' 2>/dev/null)")
+
+    local cfg_uuid ibd_uuid
+    cfg_uuid=$(echo "$profile_r" | jq -r '.response.uuid // empty' 2>/dev/null)
+    ibd_uuid=$(echo "$profile_r" | jq -r '.response.inbounds[0].uuid // empty' 2>/dev/null)
+    if [ -z "$cfg_uuid" ] || [ -z "$ibd_uuid" ]; then
+        warn "Ошибка создания конфиг-профиля: $profile_r" >&2
+        return 1
+    fi
+    ok "Конфиг-профиль создан" >&2
+
+    local node_r node_uuid
+    node_r=$(panel_api_request "POST" "/api/nodes" "$token" "$(jq -n \
+        --arg name "Steal-${selfsteal_domain}" --arg na "$node_addr" \
+        --arg cu "$cfg_uuid" --arg iu "$ibd_uuid" \
+        '{name:$name,address:$na,port:2222,configProfile:{activeConfigProfileUuid:$cu,activeInbounds:[$iu]},isTrafficTrackingActive:false,trafficLimitBytes:0,notifyPercent:0,trafficResetDay:31,excludedInbounds:[],countryCode:"XX",consumptionMultiplier:1.0}' 2>/dev/null)")
+    node_uuid=$(echo "$node_r" | jq -r '.response.uuid // empty' 2>/dev/null)
+    if [ -z "$node_uuid" ]; then
+        warn "Ошибка регистрации ноды в Panel API: $node_r" >&2
+        return 1
+    fi
+
+    panel_api_request "POST" "/api/hosts" "$token" "$(jq -n \
+        --arg cu "$cfg_uuid" --arg iu "$ibd_uuid" --arg addr "$selfsteal_domain" \
+        '{inbound:{configProfileUuid:$cu,configProfileInboundUuid:$iu},remark:$addr,address:$addr,port:443,path:"",sni:$addr,host:"",alpn:null,fingerprint:"chrome",allowInsecure:false,isDisabled:false,securityLayer:"DEFAULT"}' 2>/dev/null)" >/dev/null 2>&1 \
+        && ok "Хост создан" >&2 || warn "Ошибка создания хоста (нода уже зарегистрирована, uuid=$node_uuid)" >&2
+
+    echo "$node_uuid"
+}
+
+# panel_node_wait_connected <token> <node_uuid> [timeout_seconds] [interval_seconds]
+# Поллинг GET /api/nodes до isConnected=true у ноды с данным uuid.
+# ПРЕДПОЛОЖЕНИЕ (не подтверждено живым API): читаем список нод целиком
+# (GET /api/nodes) и фильтруем по uuid через jq — тот же паттерн, что
+# уже применяется в проекте для /api/internal-squads. Отдельный
+# GET /api/nodes/<uuid> может существовать, но не проверялся.
+panel_node_wait_connected() {
+    local token="$1" node_uuid="$2" timeout="${3:-120}" interval="${4:-10}"
+    local elapsed=0 connected="false"
+
+    info "Ожидание подключения ноды к Panel (до ${timeout}с)..."
+    while [ "$elapsed" -lt "$timeout" ]; do
+        local list_r
+        list_r=$(panel_api_request "GET" "/api/nodes" "$token" 2>/dev/null)
+        connected=$(echo "$list_r" | jq -r --arg u "$node_uuid" \
+            '(.response // .) | (if type=="array" then . else [] end) | .[] | select(.uuid==$u) | .isConnected' 2>/dev/null)
+        [ "$connected" = "true" ] && { ok "Нода подключена (isConnected=true)"; return 0; }
+        sleep "$interval"
+        elapsed=$((elapsed + interval))
+        info "Ожидание... (${elapsed}/${timeout}с)"
+    done
+
+    warn "Нода не подключилась к Panel за ${timeout}с (isConnected != true)"
+    return 1
+}
diff --git a/lib/panel/node/install.sh b/lib/panel/node/install.sh
new file mode 100644
index 0000000..fda14dc
--- /dev/null
+++ b/lib/panel/node/install.sh
@@ -0,0 +1,119 @@
+# shellcheck shell=bash
+#
+# lib/panel/node/install.sh — orchestration добавления Remote Node
+# к уже установленной панели (меню "Добавить Remote Node").
+#
+# Использует существующие примитивы без дублирования:
+#   ask_ssh_target / init_ssh_helpers / check_ssh_connection / RUN / PUT
+#       (lib/common/ssh.sh)
+#   ask / validate_domain / confirm             (lib/common/core.sh)
+#   remote_install_deps node                     (lib/common/ssh.sh)
+#   panel_generate_node_compose                  (lib/panel/node/compose.sh)
+#   panel_generate_selfsteal_site TARGET_DIR      (lib/panel/install.sh)
+#   panel_get_token / panel_api_request           (lib/panel/core.sh)
+#   panel_node_register / panel_node_wait_connected (lib/panel/node/api.sh)
+#
+# Архитектурные инварианты Stage 7 (см. lib/panel/node/compose.sh):
+#   DEST_VAL остаётся /dev/shm/nginx.sock — decoy живёт на самом Node-хосте.
+#   NODE_ADDR (Panel -> Node control API :2222) НЕ равен SELFSTEAL_DOMAIN;
+#   для MVP используется $_SSH_IP (адрес, по которому мы только что
+#   подключились по SSH) — это тот же хост, где будет слушать :2222.
+
+panel_install_remote_node() {
+    check_root
+    header "Remnawave — добавление Remote Node"
+
+    ask_ssh_target
+    init_ssh_helpers panel
+    check_ssh_connection || return 1
+
+    echo ""
+    section "Домен selfsteal"
+    local SELFSTEAL_DOMAIN
+    while true; do
+        ask SELFSTEAL_DOMAIN "Домен selfsteal этой ноды (node.example.com)"
+        validate_domain "$SELFSTEAL_DOMAIN" && break || warn "Неверный формат"
+    done
+
+    # NODE_ADDR — адрес для Panel -> Node control API (:2222).
+    # MVP: используем адрес, по которому мы только что подключились по SSH.
+    # Это НЕ то же самое, что SELFSTEAL_DOMAIN (decoy/SNI identity) —
+    # архитектурно разные параметры, совпадают только потому, что для
+    # одиночной удалённой ноды это один и тот же хост.
+    local NODE_ADDR="$_SSH_IP"
+
+    echo ""
+    local token
+    token=$(panel_get_token) || return 1
+
+    info "Получаем SECRET_KEY ноды из Panel API..."
+    local keygen_r SECRET_KEY
+    keygen_r=$(panel_api_request "GET" "/api/keygen" "$token")
+    SECRET_KEY=$(echo "$keygen_r" | jq -r '.response.secretKey // empty' 2>/dev/null)
+    if [ -z "$SECRET_KEY" ]; then
+        warn "Не удалось получить SECRET_KEY ноды: $keygen_r"
+        return 1
+    fi
+    ok "SECRET_KEY получен"
+
+    remote_install_deps node || return 1
+
+    echo ""
+    info "Генерируем конфигурацию ноды локально..."
+    panel_generate_node_compose "$SECRET_KEY" "$SELFSTEAL_DOMAIN"
+
+    local staging_dir="/opt/remnanode/selfsteal-staging"
+    panel_generate_selfsteal_site "$staging_dir"
+
+    info "Передаём файлы на ${_SSH_IP}..."
+    RUN "mkdir -p /opt/remnanode /var/www/html" 2>/dev/null
+    PUT /opt/remnanode/docker-compose.yml "${_SSH_USER}@${_SSH_IP}:/opt/remnanode/docker-compose.yml" 2>/dev/null \
+        && ok "docker-compose.yml передан" || { warn "Не удалось передать docker-compose.yml"; return 1; }
+    PUT /opt/remnanode/Caddyfile "${_SSH_USER}@${_SSH_IP}:/opt/remnanode/Caddyfile" 2>/dev/null \
+        && ok "Caddyfile передан" || { warn "Не удалось передать Caddyfile"; return 1; }
+    PUT "${staging_dir}/." "${_SSH_USER}@${_SSH_IP}:/var/www/html/" 2>/dev/null \
+        && ok "Selfsteal-сайт передан" || { warn "Не удалось передать selfsteal-сайт"; return 1; }
+
+    info "Запускаем контейнеры на ${_SSH_IP}..."
+    RUN "cd /opt/remnanode && docker compose up -d" 2>/dev/null \
+        && ok "Контейнеры запущены" || { warn "Не удалось запустить контейнеры на ноде"; return 1; }
+
+    # :2222 (Panel -> Node control API) открываем только для IP этой панели,
+    # не глобально — см. официальную рекомендацию Remnawave по firewall.
+    local panel_public_ip
+    panel_public_ip=$(hy_get_public_ip 2>/dev/null)
+    if [ -n "$panel_public_ip" ]; then
+        RUN "ufw allow from ${panel_public_ip} to any port 2222 proto tcp" >/dev/null 2>&1 \
+            && ok "Порт 2222 открыт для ${panel_public_ip}" \
+            || warn "Не удалось настроить firewall для :2222 — настройте вручную"
+    else
+        warn "Не удалось определить публичный IP этой панели — правило для :2222 не создано, настройте вручную: ufw allow from <IP панели> to any port 2222 proto tcp"
+    fi
+
+    info "Проверяем :2222 на ноде..."
+    local attempts=0
+    until RUN "ss -tlnp 2>/dev/null | grep -q ':2222 '" 2>/dev/null; do
+        attempts=$((attempts + 1))
+        [ "$attempts" -ge 6 ] && { warn ":2222 не поднялся на ноде за отведённое время"; return 1; }
+        sleep 5
+    done
+    ok "Нода слушает :2222"
+
+    echo ""
+    info "Регистрируем ноду в Panel API..."
+    local node_uuid
+    node_uuid=$(panel_node_register "$token" "$SELFSTEAL_DOMAIN" "$NODE_ADDR") || return 1
+    [ -z "$node_uuid" ] && { warn "Регистрация ноды не вернула uuid"; return 1; }
+    ok "Нода зарегистрирована (uuid=$node_uuid)"
+
+    if panel_node_wait_connected "$token" "$node_uuid"; then
+        echo ""
+        ok "Remote Node развёрнута и подключена к Panel"
+        echo -e "  ${GRAY}Адрес (control API): ${NC}${NODE_ADDR}"
+        echo -e "  ${GRAY}Selfsteal домен:     ${NC}${SELFSTEAL_DOMAIN}"
+    else
+        warn "Нода развёрнута и зарегистрирована, но Panel пока не подтвердил подключение."
+        warn "Проверьте: docker logs remnanode на ${_SSH_IP}, и что порт 2222 на ноде открыт только для IP этой панели."
+        return 1
+    fi
+}
