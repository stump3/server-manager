-    clear
-    echo ""
-    echo -e "${BOLD}${PURPLE}  REMNAWAVE PANEL${NC}"
-    echo -e "${GRAY}  ────────────────────────────────────────────${NC}"
-    local ws_svc; ws_svc="remnawave-$(_detect_ws)"
